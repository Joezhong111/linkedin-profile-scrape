# Client-side build-time variables (Vite). Only `VITE_`-prefixed values are
# exposed to the browser. Worker secrets live in `.dev.vars` locally and in
# `wrangler secret` in production; never put provider keys here.

# Google Gemini API key for the client-side AI summary feature (optional).
# Get one from https://ai.google.dev/
VITE_GEMINI_API_KEY=
