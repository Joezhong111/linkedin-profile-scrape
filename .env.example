# Database (Neon PostgreSQL)
# Get your connection string from: https://console.neon.tech/
DATABASE_URL=postgresql://user:password@your-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# Apify API Token (Server-side for Netlify Functions)
# Get your API key from: https://apify.com/account/integrations
APIFY_TOKEN=your_apify_api_key_here

# JWT Secret for authentication (min 32 chars recommended)
# Generate a secure random string for signing JWT tokens
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters

# Apify API Token (Client-side, optional for direct API calls)
VITE_APIFY_TOKEN=your_apify_api_key_here

# Google Gemini API Key (Optional, for AI analysis)
# Get your API key from: https://ai.google.dev/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

