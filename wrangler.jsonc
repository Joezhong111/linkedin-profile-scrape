{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkedin-insights-pro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Node compatibility is intentionally off: Node-only imports must fail fast.
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  // `directory` is omitted on purpose: the Cloudflare Vite plugin injects the
  // client build output into the generated deployment config.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkedin-insights-pro",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle-d1"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Deploy targets. `main`, `assets`, `triggers`, and `observability` are
  // inherited from the top level (local tests/dev use the top-level DB);
  // D1 bindings are not inherited, so each target names its own database.
  // Replace the placeholder ids with the ids printed by `wrangler d1 create`.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "linkedin-insights-pro-preview",
          "database_id": "11111111-1111-4111-8111-111111111111",
          "migrations_dir": "drizzle-d1"
        }
      ]
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "linkedin-insights-pro",
          "database_id": "22222222-2222-4222-8222-222222222222",
          "migrations_dir": "drizzle-d1"
        }
      ]
    }
  }
}
